# Copy to local.env and set the paths for your machine. local.env is not committed.
ANDROID_JAR=/usr/lib/android-sdk/platforms/android-23/android.jar
ENGINE_BIN=/path/to/yue2.cpp/build-android/yue-server
DRIVER_DIR=/path/to/driver            # libvkloader.so libturnip.so libz.so.1 libzstd.so.1 libexpat.so.1
LIBCXX=/path/to/libc++_shared.so
KEYSTORE=/path/to/release.keystore
KS_ALIAS=your-alias
KS_PASS=your-password
