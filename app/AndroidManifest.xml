<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.jackknife.killayue" android:versionCode="18" android:versionName="1.5.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Foreground MIDI discovery only. Legacy permissions remain while the app targets API 28. -->
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-feature android:name="android.software.midi" android:required="false"/>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Engine tab > Check for updates: installs a new release when the person taps Update -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <!-- setting a song's chorus as the ringtone (the user allows it in Settings) and the wake-up song -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application android:label="Killa YuE" android:icon="@mipmap/ic_launcher"
        android:theme="@style/App" android:extractNativeLibs="true"
        android:usesCleartextTraffic="true" android:largeHeap="true" android:allowBackup="false">
        <activity android:name=".MainActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Open in Killa YuE" on a friend's model-sharing page: killayue://models?from=<their address> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="killayue" android:host="models"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="hammer"/>
            </intent-filter>
        </activity>
        <activity android:name=".HammerArtistActivity" android:exported="false"/>
        <activity android:name=".HammerActivity" android:exported="false"/>
        <service android:name=".HammerCodecService" android:exported="false" android:isolatedProcess="true" android:process=":hammercodec"/>
        <service android:name=".HammerService" android:exported="false"/>
        <service android:name=".HammerFollowService" android:exported="false"/>
        <!-- sheet music: view, zoom, print and share the exported PDFs -->
        <!-- the Studio: portrait or landscape; it handles rotation itself, so the sound never restarts -->
        <activity android:name=".studio.ui.StudioActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"/>
        <activity android:name=".SheetActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"/>
        <!-- the wake-up song rings here, over the lock screen -->
        <activity android:name=".WakeActivity" android:exported="false" android:screenOrientation="portrait"
            android:launchMode="singleInstance" android:excludeFromRecents="true" android:taskAffinity=""/>
        <!-- sets the wake-up song again after a restart or an update -->
        <receiver android:name=".Wake" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <service android:name=".studio.ui.StudioService" android:exported="false" android:foregroundServiceType="microphone|mediaProjection"/>
        <service android:name=".EngineService" android:exported="false"/>
        <!-- the song engine as a library in its own app process (JNI), bound by EngineService -->
        <service android:name=".EngineHost" android:process=":engine" android:exported="false"/>
        <service android:name=".WriterHost" android:process=":writer" android:exported="false"/>
        <!-- the Studio's AI jobs (stems) in their own process, so a heavy model's memory goes back when it ends -->
        <service android:name=".studio.ui.AiHost" android:process=":ai" android:exported="false"/>
        <service android:name=".NowPlaying" android:exported="false"/>
        <receiver android:name=".Widget" android:label="Killa YuE" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info"/>
        </receiver>
        <!-- Samsung One UI: lets the now-playing chip in the status bar take our colour and icon -->
        <meta-data android:name="com.samsung.android.support.ongoing_activity" android:value="true"/>
        <provider android:name=".TrackProvider" android:authorities="ai.jackknife.killayue.tracks"
            android:exported="false" android:grantUriPermissions="true"/>
    </application>
</manifest>
