 // Parses the CSV interchange of a semantic stream
+// ---- checkpoints: what a song has made so far, kept so it can carry on ----
+// composed-<song>.json holds the score and the semantic stream (what the AR half
+// wrote) with the seeds; render-<song>.bin holds the render after every ODE step.
+// Files are written beside their place and renamed into it, so a crash never
+// leaves half a file.
+
+static bool cp_write(const std::string & path, const void * data, size_t size) {
+    std::string tmp = path + ".tmp";
+    FILE *      f   = fopen(tmp.c_str(), "wb");
+    if (!f) {
+        return false;
+    }
+    bool ok = fwrite(data, 1, size, f) == size;
+    ok      = fflush(f) == 0 && ok;
+    ok      = fsync(fileno(f)) == 0 && ok;
+    fclose(f);
+    return ok && rename(tmp.c_str(), path.c_str()) == 0;
+}
+
+static std::string cp_json_string(const std::string & s) {
+    std::string o = "\"";
+    for (unsigned char c : s) {
+        switch (c) {
+            case '"': o += "\\\""; break;
+            case '\\': o += "\\\\"; break;
+            case '\n': o += "\\n"; break;
+            case '\r': o += "\\r"; break;
+            case '\t': o += "\\t"; break;
+            default:
+                if (c < 0x20) {
+                    char b[8];
+                    snprintf(b, sizeof(b), "\\u%04x", c);
+                    o += b;
+                } else {
+                    o += (char) c;
+                }
+        }
+    }
+    return o + "\"";
+}
+
+static void cp_save_composed(const Yue2Request & r, int song, const std::string & score, const Yue2Generation & codes) {
+    std::string csv;
+    for (size_t k = 0; k < codes.tokens.size(); k++) {
+        if (k) {
+            csv += ',';
+        }
+        csv += std::to_string(codes.tokens[k] - YUE2_CODEC_OFFSET);
+    }
+    std::string j = "{\"song\":" + std::to_string(song) + ",\"seed\":" + std::to_string(r.seed) +
+                    ",\"lm_seed\":" + std::to_string(r.lm_seed + song) + ",\"truncated\":" +
+                    (codes.truncated ? "true" : "false") + ",\"frames\":" + std::to_string(codes.tokens.size()) +
+                    ",\"abc\":" + cp_json_string(score) + ",\"semantic_tokens\":" + cp_json_string(csv) + "}\n";
+    std::string path = r.checkpoint + "/composed-" + std::to_string(song) + ".json";
+    if (cp_write(path, j.data(), j.size())) {
+        fprintf(stderr, "[Checkpoint] Composition of song %d saved (%zu frames)\n", song, codes.tokens.size());
+    } else {
+        fprintf(stderr, "[Checkpoint] Could not save %s\n", path.c_str());
+    }
+}
+
+// render-<song>.bin: this header, then the latents of all M variations of the
+// song, [M, T_lat, dim]. chunk_start/steps_done say where the render stands:
+// chunks before chunk_start are finished, that chunk has steps_done steps.
+struct CpRenderHeader {
+    char    magic[4];  // "KYR1"
+    int32_t T_lat, M, dim, chunk_size, steps, chunk_start, steps_done;
+    int64_t seed;
+};
+
+struct CpStep {
+    const Yue2Request *       r;
+    std::vector<Yue2Song> *   songs;
+    int                       song, M, T_lat, dim, chunk_size, start, frames, steps;
+    const float *             block;
+};
+
+static void cp_save_render(CpStep * c, int chunk_start, int steps_done) {
+    CpRenderHeader h = {};
+    memcpy(h.magic, "KYR1", 4);
+    h.T_lat       = c->T_lat;
+    h.M           = c->M;
+    h.dim         = c->dim;
+    h.chunk_size  = c->chunk_size;
+    h.steps       = c->steps;
+    h.chunk_start = chunk_start;
+    h.steps_done  = steps_done;
+    h.seed        = c->r->seed;
+    size_t per    = (size_t) c->T_lat * c->dim;
+    std::vector<char> buf(sizeof(h) + per * c->M * sizeof(float));
+    memcpy(buf.data(), &h, sizeof(h));
+    for (int j = 0; j < c->M; j++) {
+        memcpy(buf.data() + sizeof(h) + per * j * sizeof(float), (*c->songs)[(size_t) c->song * c->M + j].latents.data(),
+               per * sizeof(float));
+    }
+    std::string path = c->r->checkpoint + "/render-" + std::to_string(c->song) + ".bin";
+    if (!cp_write(path, buf.data(), buf.size())) {
+        fprintf(stderr, "[Checkpoint] Could not save %s\n", path.c_str());
+    }
+}
+
+// after every ODE step: the chunk's state goes into the song, then to disk
+static void cp_on_step(void * data, int steps_done, const float * state) {
+    CpStep * c    = (CpStep *) data;
+    size_t   span = (size_t) c->frames * c->dim;
+    for (int j = 0; j < c->M; j++) {
+        memcpy((*c->songs)[(size_t) c->song * c->M + j].latents.data() + (size_t) c->start * c->dim, state + span * j,
+               span * sizeof(float));
+    }
+    if (steps_done >= c->steps) {
+        cp_save_render(c, c->start + c->frames, 0);  // the chunk is done: the next one starts fresh
+    } else {
+        cp_save_render(c, c->start, steps_done);
+    }
+}
+
+// loads a saved render that matches this song; returns false when there is none
+static bool cp_load_render(const Yue2Request & r, int song, std::vector<Yue2Song> * songs, int M, int T_lat, int dim,
+                           int chunk_size, int * chunk_start, int * steps_done) {
+    std::string path = r.checkpoint + "/render-" + std::to_string(song) + ".bin";
+    FILE *      f    = fopen(path.c_str(), "rb");
+    if (!f) {
+        return false;
+    }
+    CpRenderHeader h  = {};
+    bool           ok = fread(&h, sizeof(h), 1, f) == 1 && memcmp(h.magic, "KYR1", 4) == 0 && h.T_lat == T_lat &&
+              h.M == M && h.dim == dim && h.chunk_size == chunk_size && h.steps == r.steps && h.seed == r.seed;
+    size_t per = (size_t) T_lat * dim;
+    for (int j = 0; ok && j < M; j++) {
+        ok = fread((*songs)[(size_t) song * M + j].latents.data(), sizeof(float), per, f) == per;
+    }
+    fclose(f);
+    if (!ok) {
+        fprintf(stderr, "[Checkpoint] %s does not match this song, starting the render over\n", path.c_str());
+        return false;
+    }
+    *chunk_start = h.chunk_start;
+    *steps_done  = h.steps_done;
+    fprintf(stderr, "[Checkpoint] Render of song %d resumes at frame %d, step %d\n", song, h.chunk_start, h.steps_done);
+    return true;
+}
