+static bool ggml_vk_is_turnip_adreno650(const vk_device & device) {
+    return device->vendor_id == VK_VENDOR_ID_QUALCOMM &&
+           device->driver_id == vk::DriverId::eMesaTurnip &&
+           (device->properties.deviceID & 0xffffff00u) == 0x06050000u;
+}
+
 void ggml_vk_mul_mat(ggml_backend_vk_context * ctx, vk_context& subctx, const struct ggml_cgraph * cgraph, int node_idx) {
     ggml_tensor * dst = cgraph->nodes[node_idx];
     ggml_tensor * src0 = dst->src[0];
     ggml_tensor * src1 = dst->src[1];
     VK_LOG_DEBUG("ggml_vk_mul_mat(" << src0 << ", " << src1 << ", " << dst << ")");
 
+    // On Turnip/Adreno 650, the multi-column matvec shader loses the device
+    // even for tiny F32 inputs. Its single-column path and the general matmul
+    // shader pass the same reference checks. Keep single-token decoding fast,
+    // and route the small batches through the general GPU matrix kernel.
+    const bool adreno650_batched_matvec = ggml_vk_is_turnip_adreno650(ctx->device);
+
     // Handle huge A matrix by splitting the M dimensions. This works well for convolution use cases
     // where the M dimension is very large.
     // Split_k doesn't work with M splitting.
@@ -7293,7 +7305,7 @@ void ggml_vk_mul_mat(ggml_backend_vk_context * ctx, vk_context& subctx, const st
         ggml_vk_mul_mat_vec_q_f16(ctx, subctx, cgraph, node_idx, true);
     // mul_mat_vec supports batching ne12*ne13 when ne11==1, or treating ne11 as the batch size (up to four)
     // when ne12 and ne13 are one.
-    } else if ((dst->ne[1] == 1 || (dst->ne[1] <= mul_mat_vec_max_cols && src1->ne[2] * src1->ne[3] == 1)) &&
+    } else if ((dst->ne[1] == 1 || (dst->ne[1] <= mul_mat_vec_max_cols && src1->ne[2] * src1->ne[3] == 1 && !adreno650_batched_matvec)) &&
                (src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_F16 || src0->type == GGML_TYPE_BF16 || ggml_is_quantized(src0->type))) {
         ggml_vk_mul_mat_vec_q_f16(ctx, subctx, cgraph, node_idx);
     } else {
@@ -15325,6 +15337,26 @@ static bool ggml_backend_vk_device_supports_op(ggml_backend_dev_t dev, const ggm
     ggml_backend_vk_device_context * ctx = (ggml_backend_vk_device_context *)dev->context;
     const vk_device& device = ggml_vk_get_device(ctx->device);
 
+    // Only the tested Turnip/Adreno 650 needs this metadata exception.
+    // These operations describe storage without binding or dispatching it.
+    // Keep all size checks below for operations which actually access data,
+    // and preserve the original metadata behavior on every other GPU.
+    if (ggml_vk_is_turnip_adreno650(device) &&
+        (op->op == GGML_OP_NONE || op->op == GGML_OP_VIEW || op->op == GGML_OP_RESHAPE ||
+         op->op == GGML_OP_PERMUTE || op->op == GGML_OP_TRANSPOSE)) {
+        return true;
+    }
+
+    // Q6_K dequantization and matmul produce incorrect values on this device
+    // with the bundled Turnip driver. Let the scheduler use the CPU for these
+    // operations while keeping validated F32, F16 and Q5_K work on Vulkan.
+    if (ggml_vk_is_turnip_adreno650(device)) {
+        if (op->type == GGML_TYPE_Q6_K) return false;
+        for (int i = 0; i < GGML_MAX_SRC; ++i) {
+            if (op->src[i] && op->src[i]->type == GGML_TYPE_Q6_K) return false;
+        }
+    }
+
     const bool uses_bda = (op->op == GGML_OP_IM2COL || op->op == GGML_OP_IM2COL_3D) &&
