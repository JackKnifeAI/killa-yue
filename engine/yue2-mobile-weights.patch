 static bool wctx_alloc(WeightCtx * wctx, ggml_backend_t backend) {
-    wctx->buffer = ggml_backend_alloc_ctx_tensors(wctx->ctx, backend);
-    if (!wctx->buffer) {
+    std::vector<ggml_tensor *> device_weights, cpu_weights;
+    std::unordered_map<ggml_tensor *, ggml_type> unpacked;
+    ggml_backend_dev_t selected = ggml_backend_get_device(backend);
+    const bool unpack_mobile = strcmp(ggml_backend_dev_name(selected), "Vulkan0") == 0 &&
+        strcmp(ggml_backend_dev_description(selected), "Turnip Adreno (TM) 650") == 0;
+    const bool gpu = ggml_backend_dev_type(ggml_backend_get_device(backend)) != GGML_BACKEND_DEVICE_TYPE_CPU;
+    for (ggml_tensor * t = ggml_get_first_tensor(wctx->ctx); t; t = ggml_get_next_tensor(wctx->ctx, t)) {
+        bool on_cpu = false;
+        if (gpu && t->ne[1] > 1 && t->ne[2] == 1 && t->ne[3] == 1 && !t->view_src) {
+            ggml_context * probe = ggml_init({6 * ggml_tensor_overhead() + 1024, nullptr, true});
+            ggml_tensor * input = ggml_new_tensor_2d(probe, GGML_TYPE_F32, t->ne[0], 1);
+            bool has_views = false;
+            for (ggml_tensor * v = ggml_get_first_tensor(wctx->ctx); v; v = ggml_get_next_tensor(wctx->ctx, v)) {
+                has_views = has_views || v->view_src == t;
+            }
+            if (unpack_mobile && ggml_is_quantized(t->type) && !has_views) {
+                ggml_tensor * fp16 = ggml_new_tensor_2d(probe, GGML_TYPE_F16, t->ne[0], t->ne[1]);
+                if (ggml_backend_supports_op(backend, ggml_mul_mat(probe, fp16, input))) {
+                    unpacked.emplace(t, t->type);
+                    t->type = GGML_TYPE_F16;
+                    t->nb[0] = sizeof(ggml_fp16_t);
+                    for (int d = 1; d < GGML_MAX_DIMS; ++d) t->nb[d] = t->nb[d - 1] * t->ne[d - 1];
+                }
+            }
+            on_cpu = !ggml_backend_supports_op(backend, ggml_mul_mat(probe, t, input));
+            ggml_free(probe);
+        }
+        (on_cpu ? cpu_weights : device_weights).push_back(t);
+    }
+    // Keep unsupported matrix weights on the CPU instead of copying hundreds
+    // of MiB back from Vulkan for every generated token.
+    if (!cpu_weights.empty()) {
+        wctx->cpu_buffer = ggml_backend_buft_alloc_buffer_n(
+            ggml_backend_cpu_buffer_type(), cpu_weights.data(), (int) cpu_weights.size());
+        if (!wctx->cpu_buffer) {
+            fprintf(stderr, "[WeightCtx] FATAL: failed to allocate CPU fallback weights\n");
+            return false;
+        }
+        ggml_backend_buffer_set_usage(wctx->cpu_buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        fprintf(stderr, "[WeightCtx] Keeping %zu unsupported matrix tensors on CPU (%.1f MB)\n",
+                cpu_weights.size(), (double) ggml_backend_buffer_get_size(wctx->cpu_buffer) / (1024 * 1024));
+    }
+    wctx->buffer = device_weights.empty() ? nullptr : ggml_backend_buft_alloc_buffer_n(
