-    ggml_backend_buffer_set_usage(wctx->buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    if (wctx->buffer) ggml_backend_buffer_set_usage(wctx->buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
     size_t total = 0;
+    constexpr size_t convert_chunk = 1024 * 1024;
+    std::vector<float> fp32(unpacked.empty() ? 0 : convert_chunk);
+    std::vector<ggml_fp16_t> fp16(unpacked.empty() ? 0 : convert_chunk);
     for (auto & pc : wctx->pending) {
-        ggml_backend_tensor_set(pc.tensor, pc.src, pc.offset, pc.nbytes);
-        total += pc.nbytes;
+        auto converted = unpacked.find(pc.tensor);
+        if (converted == unpacked.end()) {
+            ggml_backend_tensor_set(pc.tensor, pc.src, pc.offset, pc.nbytes);
+            total += pc.nbytes;
+        } else {
+            const ggml_type type = converted->second;
+            const size_t bytes = ggml_type_size(type), block = ggml_blck_size(type);
+            GGML_ASSERT(pc.nbytes % bytes == 0 && pc.offset % bytes == 0);
+            const size_t count = pc.nbytes / bytes * block, offset = pc.offset / bytes * block;
+            const auto to_float = ggml_get_type_traits(type)->to_float;
+            for (size_t pos = 0; pos < count; pos += convert_chunk) {
+                const size_t n = std::min(convert_chunk, count - pos);
