--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -58,6 +58,27 @@
 endif()
 set(GGML_SOURCE_DIR "${CMAKE_SOURCE_DIR}/ggml" CACHE PATH "ggml source tree")
 add_subdirectory(${GGML_SOURCE_DIR} ggml)
+
+# Android extracts lib*.so from APKs; versioned .so.0 dependencies are not packaged.
+if(ANDROID)
+    set_target_properties(ggml ggml-base PROPERTIES VERSION "" SOVERSION "")
+    if(GGML_BACKEND_DL)
+        # Private names prevent the bundled static engine discovering these
+        # modules and keep shared GGML separate from other native app features.
+        set_target_properties(ggml PROPERTIES OUTPUT_NAME kyggml)
+        set_target_properties(ggml-base PROPERTIES OUTPUT_NAME kyggml-base)
+        if(TARGET ggml-vulkan)
+            set_target_properties(ggml-vulkan PROPERTIES OUTPUT_NAME kyvulkan)
+        endif()
+        get_property(cpu_targets DIRECTORY "${GGML_SOURCE_DIR}/src" PROPERTY BUILDSYSTEM_TARGETS)
+        foreach(cpu_target IN LISTS cpu_targets)
+            if(cpu_target MATCHES "^ggml-cpu-")
+                string(REGEX REPLACE "^ggml-cpu-" "kycpu-" cpu_output "${cpu_target}")
+                set_target_properties(${cpu_target} PROPERTIES OUTPUT_NAME "${cpu_output}")
+            endif()
+        endforeach()
+    endif()
+endif()
 
