diff --git a/src/context-budget.h b/src/context-budget.h
new file mode 100644
index 0000000..d864caf
--- /dev/null
+++ b/src/context-budget.h
@@ -0,0 +1,13 @@
+#pragma once
+#include <cstddef>
+
+// Reserve one slot for the end token. Validate before narrowing size_t, so
+// oversized or malformed prefixes cannot wrap into an apparently valid budget.
+static int yue2_context_token_budget(size_t prefix_tokens, int requested_tokens, int context_tokens) {
+    if (requested_tokens < 1 || context_tokens < 2 ||
+        prefix_tokens >= static_cast<size_t>(context_tokens - 1)) {
+        return 0;
+    }
+    const int available = context_tokens - 1 - static_cast<int>(prefix_tokens);
+    return requested_tokens < available ? requested_tokens : available;
+}
