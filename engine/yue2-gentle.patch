diff --git a/src/gentle.h b/src/gentle.h
new file mode 100644
index 0000000..f664d6e
--- /dev/null
+++ b/src/gentle.h
@@ -0,0 +1,32 @@
+#pragma once
+// Gentle mode for phones (Killa YuE): optional pauses between GPU jobs, so the screen and the
+// rest of the system get the GPU and CPU while a song is made. Off unless the variables are set.
+//   YUE_AR_PAUSE_MS   pause after each written token (score and melody)
+//   YUE_NAR_PAUSE_MS  pause after each render step
+//   YUE_THREADS       CPU threads for the CPU backend (default: half the cores)
+
+#include <chrono>
+#include <cstdlib>
+#include <thread>
+
+static inline int gentle_env_int(const char * name) {
+    const char * v = getenv(name);
+    int          n = v ? atoi(v) : 0;
+    return n > 0 ? n : 0;
+}
+
+static inline void gentle_sleep_ms(int ms) {
+    if (ms > 0) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+    }
+}
+
+static inline void gentle_ar_pause(void) {
+    static const int ms = gentle_env_int("YUE_AR_PAUSE_MS");
+    gentle_sleep_ms(ms);
+}
+
+static inline void gentle_nar_pause(void) {
+    static const int ms = gentle_env_int("YUE_NAR_PAUSE_MS");
+    gentle_sleep_ms(ms);
+}
