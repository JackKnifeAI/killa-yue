+    add_library(yue-engine SHARED tools/yue-server.cpp src/request.cpp src/model-store.cpp ${WEBUI_OUTPUT} ${YUE_ENGINE_JNI})
+    set_source_files_properties(tools/yue-server.cpp PROPERTIES COMPILE_DEFINITIONS "main=yue_server_main")
+    target_include_directories(yue-engine PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
+    target_link_libraries(yue-engine PRIVATE yyjson httplib log)
+    link_ggml_backends(yue-engine)
+    set_target_properties(yue-engine PROPERTIES OUTPUT_NAME yueengine)
+endif()
